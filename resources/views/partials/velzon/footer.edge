<footer class="footer">
  <div class="container-fluid">
    <div class="row">
      <div class="col-sm-6">
        &copy;
        {{ new Date().getFullYear() }}
        {{ appName }}
      </div>
      <div class="col-sm-6">
        <div class="text-sm-end d-none d-sm-block">
          Crafted by
          <a href="{{ credit.url }}" class="text-reset fw-semibold" target="_blank" rel="noopener">
            {{ credit.name }}
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
