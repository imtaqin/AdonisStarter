{{--
  Server-rendered flash messages.

  Set them from a controller with:
  session.flash('success', 'Saved')
  session.flash('error', 'Something went wrong')

  `data-auto-dismiss` is picked up by resources/js/dashboard.js.
--}}
@each((variant, key) in { success: 'success', error: 'danger', warning: 'warning', info: 'info' })
  @if(flashMessages.has(key))
    <div
      class="alert alert-{{ variant }} alert-dismissible fade show"
      role="alert"
      data-auto-dismiss="6000"
    >
      {{ flashMessages.get(key) }}
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  @end
@end
{{-- Validation errors raised by VineJS, surfaced as one summary block. --}}
@if(flashMessages.has('errorsBag'))
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    {{ flashMessages.get('errorsBag.E_VALIDATION_ERROR') || 'Please correct the errors below.' }}
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
@end
