{{--
  Props
  variant      string   primary | secondary | success | danger | warning | info | light | dark
  dismissible  boolean  adds a close button
  autoDismiss  number   milliseconds before it closes itself
  icon         string   Font Awesome class rendered on the left

  Uses Bootstrap's own alert behaviour rather than Alpine, because the dashboard
  layout loads the theme's Bootstrap bundle and not resources/js/app.js.
--}}
@let(variant = $props.get('variant') || 'primary')
@inject({ variant, autoDismiss: $props.get('autoDismiss') })
@let(dismissible = $props.get('dismissible') !== false)
@let(classes = [
  'alert',
  `alert-${variant}`,
  dismissible ? 'alert-dismissible fade show' : '',
  $props.get('icon') ? 'd-flex align-items-start' : '',
])

<div {{
  $props
    .except(['variant', 'autoDismiss', 'dismissible', 'icon'])
    .merge({ role: 'alert', class: classes })
    .mergeIf($props.get('autoDismiss'), { 'data-auto-dismiss': $props.get('autoDismiss') })
    .toAttrs()
}}>
  @if($props.get('icon'))
    <i class="{{ $props.get('icon') }} me-2 fs-18"></i>
    <div>{{{ await $slots.main() }}}</div>
  @else
    {{{ await $slots.main() }}}
  @end
  @if(dismissible)
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  @end
</div>
