{{--
  Dashboard layout — picks a shell for the active theme.

  Every page still writes `@layouts.dashboard({ title, subtitle })`. This file
  exists so that adding a theme does not mean touching those pages: it forwards
  the props and every slot to the shell named by `config/themes.ts`.

  `theme` is shared per request by share_view_data_middleware, already resolved
  against the allowlist, so `theme.layout` can never be an arbitrary path.

  Shells live in components/layouts/themes/. A new one must accept the same
  props and slots that components/layouts/themes/imtaqin.edge documents.
--}}

@component(theme.layout, $props.all())
  {{--
    Every optional slot is declared unconditionally and guarded *inside*, because
    `@slot` must be a direct child of `@component` -- wrapping one in `@if` fails
    to compile with E_ORPHAN_SLOT_TAG.

    So the shell always sees these slots as defined, and a page that passes none
    yields an empty render rather than a missing slot. The shells only use these
    slots to emit <link>/<script>/button markup, so an empty one costs whitespace
    and nothing else.
  --}}
  @slot('main')
    {{{ await $slots.main() }}}
  @end

  @slot('styles')
    @if($slots.styles)
      {{{ await $slots.styles() }}}
    @end
  @end

  @slot('scripts')
    @if($slots.scripts)
      {{{ await $slots.scripts() }}}
    @end
  @end

  @slot('pageActions')
    @if($slots.pageActions)
      {{{ await $slots.pageActions() }}}
    @end
  @end
@end
