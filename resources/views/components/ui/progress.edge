{{--
  Props
  value    number   0-100
  label    string   text above the bar
  variant  string   colour (default 'primary')
  size     string   'xs' | 'sm' | 'md' | 'lg' (theme sizes)
  striped  boolean
  animated boolean
  showValue boolean render the percentage on the right of the label
--}}
@let(value = Math.max(0, Math.min(100, Number($props.get('value', 0)))))
@let(variant = $props.get('variant', 'primary'))
@if($props.get('label'))
  <div class="d-flex align-items-center justify-content-between mb-1">
    <span class="fs-12 text-muted">{{ $props.get('label') }}</span>
    @if($props.get('showValue') !== false)
      <span class="fs-12 fw-semibold">{{ value }}%</span>
    @end
  </div>
@end

<div
  class="progress {{ $props.get('size') ? `progress-${$props.get('size')}` : '' }}"
  role="progressbar"
  aria-label="{{ $props.get('label', 'Progress') }}"
  aria-valuenow="{{ value }}"
  aria-valuemin="0"
  aria-valuemax="100"
>
  <div
    class="progress-bar bg-{{ variant }} {{ $props.get('striped') ? 'progress-bar-striped' : '' }} {{ $props.get('animated') ? 'progress-bar-animated' : '' }}"
    style="width: {{ value }}%"
  ></div>
</div>
