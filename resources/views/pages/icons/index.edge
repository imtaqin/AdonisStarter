@layouts.dashboard({ title: 'Icons', subtitle: 'Font Awesome Pro 7' })
  @if(!available)
    @alert.root({
      variant: 'warning',
      dismissible: false,
      icon: 'fa-solid fa-triangle-exclamation',
    })
      @!alert.title({ text: 'Icon index not built' })
      @alert.description()
        Run
        <code>npm run theme:fontawesome</code>
        to generate it from the Font
        Awesome Pro bundle.
      @end
    @end
  @else
    @ui.card()
      @slot('header')
        <div>
          <div class="card-title">{{ pagination.total }} icons</div>
          <span class="text-muted fs-12">
            Click any icon to copy its class. Agents should use the
            <code>search_icons</code>
            MCP tool instead.
          </span>
        </div>
      @end
      @slot('actions')
        <form method="GET" action="/icons" class="d-flex align-items-center gap-2">
          <div class="input-group input-group-sm" style="width: 220px">
            <input
              type="search"
              class="form-control"
              name="search"
              value="{{ filters.search }}"
              placeholder="Search icons…"
              aria-label="Search icons"
            />
            <button class="btn btn-primary" type="submit">
              <i class="fa-solid fa-magnifying-glass"></i>
            </button>
          </div>

          <select name="style" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">All styles</option>
            @each(style in styles)
              <option value="{{ style }}" {{ filters.style === style ? 'selected' : '' }}>
                {{ style }}
              </option>
            @end
          </select>

          <noscript><button class="btn btn-sm btn-light" type="submit">Filter</button></noscript>
        </form>
      @end
      @if(icons.length === 0)
        @!ui.empty({
          title: 'No icons found',
          description:
            'Try a plainer word — the search covers names, labels and synonyms.',
          icon: 'fa-solid fa-magnifying-glass',
        })
      @else
        <div class="row g-2">
          @each(icon in icons)
            <div class="col-xxl-1 col-xl-2 col-lg-2 col-md-3 col-4">
              {{--
                data-copy is handled by resources/js/dashboard.js, so no inline
                handler is needed and CSP can stay tight.
              --}}
              <button
                type="button"
                class="btn btn-light w-100 d-flex flex-column align-items-center gap-1 py-3 border"
                data-copy="{{ icon.class }}"
                title="{{ icon.label }} — {{ icon.class }}"
              >
                <i class="{{ icon.class }} fs-20"></i>
                <span class="fs-10 text-muted text-truncate w-100">{{ icon.name }}</span>
              </button>
            </div>
          @end
        </div>

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-4">
          <div class="text-muted fs-12">
            Showing
            {{ pagination.from }}
            to
            {{ pagination.to }}
            of
            {{ pagination.total }}
          </div>
          @if(pagination.lastPage > 1)
            <nav aria-label="Pagination">
              <ul class="pagination pagination-sm mb-0">
                <li class="page-item {{ pagination.current === 1 ? 'disabled' : '' }}">
                  <a class="page-link" href="{{ pagination.urlFor(pagination.current - 1) }}">
                    Prev
                  </a>
                </li>
                <li class="page-item disabled">
                  <span class="page-link">
                    {{ pagination.current }}
                    /
                    {{ pagination.lastPage }}
                  </span>
                </li>
                <li
                  class="page-item {{ pagination.current === pagination.lastPage ? 'disabled' : '' }}"
                >
                  <a class="page-link" href="{{ pagination.urlFor(pagination.current + 1) }}">
                    Next
                  </a>
                </li>
              </ul>
            </nav>
          @end
        </div>
      @end
    @end
    @ui.card({ title: 'Usage', class: 'mt-3' })
      <div class="row">
        <div class="col-md-6">
          <p class="fw-semibold fs-13 mb-2">Styles shipped</p>
          <ul class="list-unstyled fs-12 mb-0">
            @each(style in styles)
              <li class="mb-1">
                <i class="fa-{{ style }} fa-star me-2"></i>
                <code>fa-{{ style }} fa-star</code>
              </li>
            @end
          </ul>
        </div>
        <div class="col-md-6">
          <p class="fw-semibold fs-13 mb-2">Sizing</p>
          <p class="fs-12 text-muted mb-2">
            <code>fa-xs fa-sm fa-lg fa-xl fa-2x … fa-10x</code>, plus
            <code>fa-fw</code>
            for fixed width.
          </p>
          <p class="fs-12 text-muted mb-0">
            <code>thin</code>
            and the
            <code>sharp-*</code>
            family are not vendored — add them to
            <code>STYLES</code>
            in
            <code>scripts/vendor-fontawesome.mjs</code>
            and re-run
            <code>npm run theme:fontawesome</code>.
          </p>
        </div>
      </div>
    @end
  @end
@end
