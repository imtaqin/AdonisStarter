@layouts.dashboard({
  title: 'New role',
  breadcrumbs: [
    { label: 'Administration' },
    { label: 'Roles', href: route('roles.index') },
  ],
})
  @ui.card()
    @form({ route: 'roles.store', method: 'POST' })
      @include('pages/roles/_form')

      <div class="d-flex justify-content-end gap-2">
        @!link({ route: 'roles.index', text: 'Cancel', variant: 'light' })
        @!button({ type: 'submit', text: 'Create role' })
      </div>
    @end
  @end
@end
