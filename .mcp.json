{
  "mcpServers": {
    "adonis-boost": {
      "type": "stdio",
      "command": "node",
      "args": [
        "--import=@poppinss/ts-exec",
        "mcp/boost/server.ts"
      ],
      "env": {}
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chromium"
      ],
      "env": {}
    }
  }
}
