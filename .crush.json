{
  "$schema": "https://charm.land/crush.json",
  "options": {
    "initialize_as": "AGENTS.md"
  },
  "mcp": {
    "adonis-boost": {
      "type": "stdio",
      "command": "node",
      "args": [
        "--import=@poppinss/ts-exec",
        "mcp/boost/server.ts"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chromium"
      ]
    }
  }
}
