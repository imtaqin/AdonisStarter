# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie
LIMITER_STORE=database

# Database — pick one via DB_CONNECTION (default: sqlite, zero-config)
# sqlite:  DB_CONNECTION=sqlite  (optional DB_FILENAME, default tmp/db.sqlite3)
# pg:      DB_CONNECTION=pg      + DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_DATABASE  (npm i pg)
# mysql:   DB_CONNECTION=mysql   + DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_DATABASE  (npm i mysql2)
# mssql:   DB_CONNECTION=mssql   + DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_DATABASE  (npm i tedious)
# libsql:  DB_CONNECTION=libsql  + LIBSQL_URL (+ LIBSQL_AUTH_TOKEN)                  (npm i @libsql/client)
DB_CONNECTION=sqlite
#DB_HOST=127.0.0.1
#DB_PORT=5432
#DB_USER=
#DB_PASSWORD=
#DB_DATABASE=
#DB_FILENAME=
#LIBSQL_URL=
#LIBSQL_AUTH_TOKEN=

# Seeded admin (used by `node ace db:seed` on a fresh install only)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Local scaffolding: auto sign-in as the seeded admin (never enable in production)
AUTH_BYPASS=false
